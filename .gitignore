
# ============================================================
# WATTWISE - CONFIGURACION DE ARCHIVOS IGNORADOS POR GIT
# ============================================================
# Proyecto: WattWise
# Objetivo: Proteger datos locales confidenciales y evitar versionar
#           artefactos generados o configuraciones de entorno.
# ============================================================


# ------------------------------------------------------------
# 1. ENTORNOS VIRTUALES Y GESTORES DE PYTHON (uv / pip)
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
.uv/
.uv-cache/
.python-version.local


# ------------------------------------------------------------
# 2. CACHE Y ARTEFACTOS GENERADOS POR PYTHON
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.prof


# ------------------------------------------------------------
