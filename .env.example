
# ============================================================
# WATTWISE - EJEMPLO DE CONFIGURACION DEL ENTORNO
# ============================================================
# Proyecto: WattWise
#
# OBJETIVO:
# Documentar las variables de configuracion local.
#
# SEGURIDAD:
# - Este archivo puede versionarse en Git.
# - No incluir contrasenas, tokens ni credenciales reales.
# - El archivo .env privado esta excluido de Git y Docker.
# - Los datos electricos permanecen locales.
# - No se requieren servicios externos ni APIs de pago.
#
# CONFIGURACION:
# - Las variables seran gestionadas por configuracion.py.
# - El archivo .env es opcional.
# - Las variables del sistema tienen prioridad sobre .env.
# - Si no existe .env, se usan valores predeterminados seguros.
#
# IMPORTANTE:
# Este archivo es una plantilla, no contiene secretos reales.
# ============================================================


# ------------------------------------------------------------
# 1. ENTORNO DE EJECUCION
# ------------------------------------------------------------

# Valores permitidos: local, pruebas, produccion.
# El valor predeterminado es local.
WATTWISE_ENTORNO=local

# Zona horaria predeterminada para presentar fechas.
# No modifica silenciosamente la zona horaria de los datos.
WATTWISE_ZONA_HORARIA=America/Bogota


# ------------------------------------------------------------
# 2. ALMACENAMIENTO LOCAL
# ------------------------------------------------------------

# Carpeta privada para archivos, resultados e informes.
# Debe estar excluida de Git y Docker.
WATTWISE_DIRECTORIO_DATOS=datos_locales

# Base de datos SQLite de la aplicacion.
# Se resuelve respecto a la raiz del proyecto.
WATTWISE_BASE_DATOS=datos_locales/wattwise.sqlite3


# ------------------------------------------------------------
# 3. LIMITES DE IMPORTACION
# ------------------------------------------------------------

# Tamano maximo permitido por archivo, en megabytes.
WATTWISE_MAX_ARCHIVO_MB=25

# Numero maximo de filas por archivo importado.
WATTWISE_MAX_FILAS=100000

# Formato Excel autorizado inicialmente.
# No se aceptan macros ni formatos antiguos.
WATTWISE_FORMATOS_PERMITIDOS=.xlsx


# ------------------------------------------------------------
# 4. CONFIGURACION DE SQLITE
# ------------------------------------------------------------

# Tiempo maximo de espera ante bloqueos, en segundos.
WATTWISE_SQLITE_TIMEOUT_SEGUNDOS=10

# Activar modo Write-Ahead Logging cuando sea compatible
# con el sistema de archivos utilizado.
WATTWISE_SQLITE_WAL=true


# ------------------------------------------------------------
# 5. APRENDIZAJE AUTOMATICO LOCAL
# ------------------------------------------------------------

# Semilla para reproducibilidad de los experimentos.
WATTWISE_ML_SEMILLA=42

# Minimo inicial de observaciones validas para habilitar
# el analisis exploratorio mediante Isolation Forest.
WATTWISE_ML_MIN_OBSERVACIONES=30


# ------------------------------------------------------------
# 6. REGISTRO DE EVENTOS
# ------------------------------------------------------------

# Niveles permitidos:
# DEBUG, INFO, WARNING, ERROR, CRITICAL.
WATTWISE_LOG_NIVEL=INFO

# Los logs no deben registrar:
# - Credenciales o informacion sensible.
# - Contenido completo de archivos de usuarios.
# - Mediciones privadas innecesarias.
# - Informacion confidencial de proyectos.


# ============================================================
# FIN DE .ENV.EXAMPLE - WATTWISE
# ============================================================
